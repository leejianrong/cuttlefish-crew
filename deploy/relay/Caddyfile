# In front of the hosted relay (ADR-0043, CUT-135). Caddy gets the certificate and terminates https.
#
# Until the outside security review (ADR-0037, CUT-149) the whole site sits behind one shared password,
# so only the owner can load the page or reach the relay's own routes. The one exception is the
# daemon's websocket: it dials in from a PC that cannot answer a password prompt, and it is already
# gated by its room's registration token, which the relay checks.
#
# It runs in the compose stack (compose.yaml) and is shipped inside the relay image, so it reaches
# the Droplet only through the deploy pipeline. Settings come from the environment:
#
# RELAY_ADDRESS      the site address: the domain in production, or ":80" for a plain-http local run
# GATE_USER          the user name for the shared password
# GATE_PASSWORD_HASH a bcrypt hash (never the password itself)
# RELAY_UPSTREAM     where the relay listens: relay:8450 in the stack
# ACME_CA            optional. Set to Let's Encrypt's staging directory for a first run, so a mistake
#                    cannot use up the real rate limit

{
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

{$RELAY_ADDRESS} {
	encode zstd gzip

	# Caddy replaces any X-Forwarded-For the client sent with the address it saw, which is the one
	# the relay counts limits against.
	@daemon path /ws/daemon/*
	handle @daemon {
		reverse_proxy {$RELAY_UPSTREAM}
	}

	handle {
		basic_auth {
			{$GATE_USER} {$GATE_PASSWORD_HASH}
		}
		reverse_proxy {$RELAY_UPSTREAM}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output file /var/log/caddy/relay-access.log {
			roll_size 10MiB
			roll_keep 14
			roll_keep_for 336h
		}
	}
}
