# In front of the hosted relay (ADR-0043, CUT-135). Caddy gets the certificate and terminates https.
#
# Until the outside security review (ADR-0037, CUT-149) the whole site sits behind one shared password,
# so only the owner can load the page or reach the relay's own routes. The one exception is the
# daemon's websocket: it dials in from a PC that cannot answer a password prompt, and it is already
# gated by its room's registration token, which the relay checks.
#
# RELAY_ADDRESS      the site address: the domain in production, or ":8080" for a plain-http local test
# GATE_USER          the user name for the shared password
# GATE_PASSWORD_HASH from `caddy hash-password` (never the password itself)
# RELAY_UPSTREAM     where the relay listens; 127.0.0.1:8450 in production

{$RELAY_ADDRESS} {
	encode zstd gzip

	# Caddy replaces any X-Forwarded-For the client sent with the address it saw, which is the one
	# the relay counts limits against.
	@daemon path /ws/daemon/*
	handle @daemon {
		reverse_proxy {$RELAY_UPSTREAM:127.0.0.1:8450}
	}

	handle {
		basic_auth {
			{$GATE_USER} {$GATE_PASSWORD_HASH}
		}
		reverse_proxy {$RELAY_UPSTREAM:127.0.0.1:8450}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output file /var/log/caddy/relay-access.log {
			roll_size 10MiB
			roll_keep 14
			roll_keep_for 336h
		}
	}
}
